# Export these in your shell or supply through your process manager.
LISTEN_ADDR=127.0.0.1:8080
DATA_FILE=data/portal.json
# Required when LISTEN_ADDR binds outside loopback.
API_TOKEN=
# Optional read-only monitoring integration.
PROMETHEUS_URL=
PROMETHEUS_TOKEN=

# Optional Alisa Cloud OAuth (opaque tokens + PKCE + remote authorization).
# Setting issuer requires all client settings. Keep secrets out of Git.
ALISA_OAUTH_ISSUER=
ALISA_PORTAL_ORIGIN=
ALISA_OAUTH_CLIENT_ID=
ALISA_OAUTH_CLIENT_SECRET=
ALISA_OAUTH_RESOURCE_CLIENT_ID=
ALISA_OAUTH_RESOURCE_CLIENT_SECRET=
ALISA_OAUTH_TENANT_ID=
# Legacy admin token is disabled by default once OAuth is enabled.
ALISA_OAUTH_ALLOW_API_TOKEN=false
